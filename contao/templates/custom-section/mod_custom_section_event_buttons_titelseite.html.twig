{% do addHtmlToHead('
    <style'~attrs().setIfExists('nonce', csp_nonce('script-src'))~'>
    .event-type-buttons .btn {
        border-color: #fff !important;
    }

    .event-type-buttons .btn:hover {
        background: #000 !important;
        border-color: #000 !important;
    }
    </style>
') %}

{% set tours = { 'Wanderung': '?tourType=6&amp;getUpcoming=1', 'Klettern Halle': '?tourType=11&amp;getUpcoming=1', 'Klettern Fels': '?tourType=4&amp;getUpcoming=1', 'Hochtour': '?tourType=2&amp;getUpcoming=1', 'Skitour': '?tourType=1&amp;getUpcoming=1', 'Mountainbike': '?tourType=10&amp;getUpcoming=1', 'Weitere Touren...': '?getUpcoming=1' } %}
{% set courses = { 'Basis Halle': '?courseType=24&amp;getUpcoming=1', 'Sportklettern': '?courseType=3&amp;getUpcoming=1', 'Hochtouren': '?courseType=2&amp;getUpcoming=1', 'Lawinenkunde': '?courseType=10&amp;getUpcoming=1', 'Skitouren': '?courseType=11&amp;getUpcoming=1', 'Skitechnik': '?courseType=12&amp;getUpcoming=1', 'Weitere Kurse...': '?getUpcoming=1' } %}
<div class="event-type-buttons">
    <div class="button-list-horizontal-scroll">
        <nav class="button-list-horizontal-scroll--wrapper">
            <h4>TOUREN:</h4>
            <ul class="button-list-horizontal-scroll--list">
                {% for event_type,url_param in tours %}
                    {# small screens #}
                    <li class="d-inline d-md-none"><a href="touren-trainings-und-anlaesse.html{{ url_param }}" title="{{ event_type }}" tabindex="0" itemprop="url" class="btn btn-sm btn-outline-dark"><span itemprop="name">{{ event_type }}</span></a></li>
                    {# large screens #}
                    <li class="d-none d-md-inline"><a href="touren-trainings-und-anlaesse.html{{ url_param }}" title="{{ event_type }} " tabindex="0" itemprop="url" class="btn btn-lg btn-outline-dark"><span itemprop="name">{{ event_type }}</span></a></li>
                {% endfor %}
            </ul>
        </nav>
        <nav class="button-list-horizontal-scroll--wrapper">
            <h4>KURSE:</h4>
            <ul class="button-list-horizontal-scroll--list">
                {% for event_type,url_param in courses %}
                    {# small screens #}
                    <li class="d-inline d-md-none"><a href="kurse.html{{ url_param }}" title="{{ event_type }}" tabindex="0" itemprop="url" class="btn btn-sm btn-outline-dark"><span itemprop="name">{{ event_type }}</span></a></li>
                    {# large screens #}
                    <li class="d-none d-md-inline"><a href="kurse.html{{ url_param }}" title="{{ event_type }}" tabindex="0" itemprop="url" class="btn btn-lg btn-outline-dark"><span itemprop="name">{{ event_type }}</span></a></li>
                {% endfor %}
            </ul>
        </nav>
    </div>
</div>
