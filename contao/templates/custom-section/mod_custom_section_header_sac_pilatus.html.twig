<div class="header-custom-template">
    <div class="header-navbar-row-0">

        <div class="inner d-flex px-3 py-1 py-sm-1 align-items-center">
            <div class="ms-0 me-auto d-flex ">
                <div class="ms-0 d-flex align-items-center header-backoffice-link">{{ insert_tag('link_open::geschaeftsstelle')|raw }}<i class="fa-solid fa-envelope me-1 align-bottom"></i><span class="d-none d-sm-inline">Geschäftsstelle</span>{{ insert_tag('link_close')|raw }}</div>
            </div>
            <div class="ms-auto me-0 d-flex align-items-center">
                {% if has_logged_in_frontend_user() %}
                    {% set user = get_logged_in_frontend_user() %}
                    <div class="d-none d-sm-block me-2">
                        Angemeldet als:
                    </div>
                    <div class="dropdown">
                        <!-- indexer::stop -->
                        <button class="btn dropdown-toggle btn-danger" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            {{ substr((user.firstname~' '~user.lastname|first~'.'), 25) }}
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-3 overflow-hidden">
                            <div class="row gx-2 align-items-center flex-nowrap">
                                <div class="col-auto">
                                    <a href="{{ insert_tag('link_url::276') }}" title="Mitgliederprofil bearbeiten">
                                        {{ insert_tag('image::'~getAvatarResourcePath(user)~'?width=32&height=32&mode=crop&class=rounded-circle')|raw }}
                                    </a>
                                </div>
                                <div class="col-auto">
                                    <div class="fw-bold">Mitgl.-Nr. {{ user.sacMemberId|default('---') }}</div>
                                    <div>{{ substr(user.email|default('E-Mail: ---'), 19) }}</div>
                                </div>
                            </div>
                            <nav>
                                <ul class="p-0 m-0 mt-4">
                                    {% if has_backend_account() %}
                                        <li class="d-flex align-items-center">
                                            <a class="dropdown-item" target="_blank" rel="noopener" href="/contao"><i class="fa-brands fa-fw fa-contao"></i><span class="ms-1">Zum Contao Backend</span></a>
                                        </li>
                                        <li class="d-flex align-items-center">
                                            {# Link to: Anleitungen und Tutorials #}
                                            <a class="dropdown-item" href="{{ insert_tag('link_url::315') }}"><i class="fa-solid fa-fw fa-square-question"></i><span class="ms-1">{{ insert_tag('link_name::315') }}</span></a>
                                        </li>
                                    {% endif %}
                                    <li class="d-flex align-items-center">
                                        {% set attributes = attrs()
                                            .set('href', path('contao_frontend_logout'))
                                            .set('data-href', path('contao_frontend_logout'))
                                            .set('data-targetpath', app.request.getSchemeAndHttpHost())
                                            .set('data-logout-label', 'du wirst abgemeldet …')
                                            .set('title', 'Abmelden/Logout')
                                            .addClass('trigger-ids-kill-session header-logout-link dropdown-item') %}
                                        <a href="{{ insert_tag('link_url::276') }}" title="Mitgliederprofil bearbeiten" class="dropdown-item"><i class="fa-light fa-fw fa-cog"></i><span class="ms-1">Mitgliederprofil bearbeiten</span></a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li class="d-flex align-items-center">
                                        <a href="{{ insert_tag('link_url::419') }}" title="Meine Buchungen" class="dropdown-item"><i class="fa-light fa-fw fa-calendar-check"></i><span class="ms-1">Meine Buchungen</span></a>
                                    </li>
                                    <li class="d-flex align-items-center">
                                        <a href="{{ insert_tag('link_url::471') }}" title="Meine Merkliste" class="dropdown-item"><i class="fa-light fa-fw fa-heart"></i><span class="ms-1">Meine Merkliste</span></a>
                                    </li>
                                    <li class="d-flex align-items-center">
                                        <a href="{{ insert_tag('link_url::422') }}" title="Meine Tourenberichte" class="dropdown-item"><i class="fa-light fa-fw fa-pen-to-square"></i><span class="ms-1">Meine Tourenberichte</span></a>
                                    </li>
                                   <li class="d-flex align-items-center">
                                        <a href="{{ insert_tag('link_url::425') }}" title="Mein Bilder-Feed" class="dropdown-item"><i class="fa-light fa-fw fa-image"></i><span class="ms-1">Mein Bilder-Feed</span></a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li class="d-flex align-items-center">
                                        <a{{ attributes }}><i class="fa-light fa-fw fa-sign-out-alt"></i><span class="ms-1">Abmelden</span></a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                        {% add to head %}
                            <style{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
                                {% apply scss %}
                                #header .header-navbar-row-0 {
                                    .dropdown > button.btn {
                                        padding: .125rem .5rem !important;
                                        font-size: 12px !important;
                                    }

                                    .dropdown-menu {
                                        background: white;
                                    }

                                    .dropdown-menu a.dropdown-item {
                                        padding: .25rem 0;
                                    }

                                    .dropdown-menu * {
                                        color: #000 !important;
                                    }
                                }

                                {% endapply %}
                            </style>
                        {% endadd %}
                        <!-- indexer::continue -->
                    </div>
                {% endif %}

                {% if not has_logged_in_frontend_user() %}
                    <div class="header-login-placeholder d-inline position-relative" style="width:120px">
                        <span class="placeholder-glow">
                            <span class="placeholder col-2"></span>
                            <span class="placeholder col-9"></span>
                        </span>
                    </div>
                    <button data-controller="sacptheme--frontend--bs-login-modal" data-action="click->sacptheme--frontend--bs-login-modal#open" data-sac-login-target="same-site" aria-haspopup="dialog" class="header-login-button p-0 d-none ms-2 me-0 mt-2 mb-2" tabindex="0"><i class="fa-solid fa-sign-in me-2"></i>Mitglieder-Login</button>
                    <script{{ attrs().setIfExists('nonce', csp_nonce('script-src')) }}>
                      document.addEventListener("BootstrapModalReady", (event) => {
                        document.querySelector('.header-login-placeholder').remove();
                        document.querySelector('.header-login-button').classList.remove('d-none');
                        document.querySelector('.header-login-button').removeAttribute('onclick');
                      });
                    </script>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="header-navbar-row-1">
        <div class="inner hide-from-print navbar navbar-expand navbar-dark flex-md-row bd-navbar align-items-center py-0 py-sm-2">
            <div class="navbar-brand ms-3">
                <a href="{{ app.request.getSchemeAndHttpHost() }}" title="Gehe zur Startseite">
                    <img src="{{ asset('images/logos/logo-header.svg', 'markocupic_contao_theme_sac_pilatus') }}" class="logo-header" alt="Logo SAC-Pilatus">
                </a>
            </div>

            <!-- NAVBAR-START -->
            <div class="navbar-header d-none d-xl-flex align-items-center">
                {{ insert_tag('insert_module::307')|raw }}
            </div>
            <!-- NAVBAR-END -->

            <div class="header-button-container ms-auto d-flex align-items-center justify-content-end">
                <a href="{{ insert_tag('link_url::touren-trainings-und-anlaesse') }}" class="d-none d-md-block btn btn-sm btn-primary ms-2"><i class="fa-regular fa-mountains"></i> Touren</a>
                <a href="{{ insert_tag('link_url::kurse') }}" class="d-none d-md-block btn btn-sm btn-danger ms-2 me-2"><i class="fa-regular fa-signal"></i> Kurse</a>

                <!-- Searchbar toggler -->
                <button id="openWebsiteSearchButton" class="btn btn-lg btn-link ps-2 ps-sm-3 pe-2 pe-2 pe-sm-3 ms-3 search-toggler" data-action="search-bar-toggle" aria-expanded="false" aria-controls="websiteSearch" aria-label="Suche öffnen">
                    <i class="fa-regular fa-search" aria-label="Suche" title="Suche"></i>
                </button>
                <!-- End Searchbar toggler -->

                <!-- Navbar toggler mobile -->
                <button class="navigation-toggler d-xl-none btn btn-lg btn-link ps-2 ps-sm-3 pe-2 pe-2 pe-sm-3 ms-2" aria-expanded="false" aria-controls="sidebar" aria-label="Navigation öffnen">
                    <i class="fa-regular fa-lg fa-bars"></i>
                </button>
                <!-- End Navbar toggler mobile -->
            </div>
        </div>
    </div>

    <!-- Search module -->
    {{ insert_tag('insert_module::353')|raw }}
</div>

<!-- Login Modal -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabelLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="bg-white modal-header">
                <h3 class="modal-title">Mitglieder Login</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Login-Formular schliessen" tabindex="0"></button>
            </div>
            <div class="modal-body">
                <div class="mt-0">
                    <p class="my-0">
                        Als Mitglied der SAC Sektion Pilatus kannst du dich mit deinem <strong>SAC-Login</strong> hier anmelden.
                    </p>
                    <div class="mt-4">
                        {{ insert_tag('insert_module::396')|raw }}
                    </div>
                    <p class="mt-4 mb-0">
                        Verwende deine <strong>Mitgliedernummer oder E-Mail-Adresse</strong> und das <strong>Passwort</strong> deines SAC-Kontos.
                    </p>
                    <h5 class="mt-4 d-block">Was ist das SAC-Konto &amp; SAC-Portal?</h5>
                    <p>Auf der nachfolgenden SAC/CAS-Seite werden die häufigsten Fragen rund um das <strong>SAC-Login</strong> und das <strong>SAC-Portal</strong>beantwortet:</p>
                    <div class="d-block mt-4">
                        <p><a class="btn btn-outline-danger" href="https://www.sac-cas.ch/de/meta/faq/faq-sac-konto-/-sac-portal/" rel="noopener" target="_blank" download="SAC Login FAQ">Häufige Fragen zum SAC-Login/SAC-Portal</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
