        .content h3 {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 16px;
            line-height: 22px;
            font-weight: 700;
            color: #0f1f2e;
            margin: 24px 0 8px 0;
        }

        .content p {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 16px;
            line-height: 26px;
            color: #3a4654;
            margin: 0 0 16px 0;
        }

        .content ul, .content ol {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 16px;
            line-height: 26px;
            color: #3a4654;
            margin: 0 0 16px 0;
            padding-left: 22px;
        }

        .content li {
            margin: 0 0 6px 0;
        }

        .content a {
            color: #026ca0;
            text-decoration: underline;
        }

        .content b, .content strong {
            color: #0f1f2e;
        }

        .content hr {
            border: 0;
            border-top: 1px solid #e6ebf0;
            margin: 28px 0;
            height: 0;
        }

        .content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
        }

        /* ---------- Mobile ---------- */
        @media screen and (max-width: 620px) {
            .container {
                width: 100% !important;
                max-width: 100% !important;
            }

            .px {
                padding-left: 20px !important;
                padding-right: 20px !important;
            }

            .stack {
                display: block !important;
                width: 100% !important;
            }

            .nav-cell {
                padding-top: 12px !important;
                text-align: left !important;
            }

            .content h1 {
                font-size: 24px !important;
                line-height: 30px !important;
            }

            .btn-cell {
                display: block !important;
                width: 100% !important;
                padding-bottom: 10px !important;
            }

            .btn-cell a {
                display: block !important;
                text-align: center !important;
            }

            .btn-gap {
                display: none !important;
            }

            .btn-table {
                width: 100% !important;
            }
        }
    </style>
</head>

