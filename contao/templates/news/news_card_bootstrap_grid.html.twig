<li class="news_card mb-1 col-12 col-sm-6 col-md-4 col-xl-3{{ class|default('') }}" itemscope itemtype="http://schema.org/Article">
    {% set card_props = {
        card_attributes: attrs().addClass('with-border-bottom-gradient'),
        card_link: insert_tag('news_url::'~id),
        card_image_path: addImage|default ? singleSRC : null,
        card_image_size: size|default('')|deserialize[2],
        card_title_text: newsHeadline,
        card_text_text: teaser|default('')|striptags|raw|slice(0, 100),
        card_text_attributes: attrs().addClass('card-news-teaser'),
        card_date_text: date,
        card_date_attributes: { 'datetime': datetime },
    } %}
    {#
    We hardcode the image size so that incorrect entries by users in the Contao backend
    do not lead to an incorrect image size.
    #}
    {% set card_props = card_props|merge({card_image_size: 29}) %}
    {% include '@MarkocupicContaoThemeSacPilatus/Card/card_default.html.twig' with card_props only %}
</li>
{# card_image_size: size|default('')|deserialize[2], #}
