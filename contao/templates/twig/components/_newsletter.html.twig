<body id="body" class="bg-page" style="margin: 0; padding: 0; background-color: #eef2f5; width: 100%;" bgcolor="#eef2f5">

<!-- Vorschautext (im Posteingang sichtbar, im Mail unsichtbar) -->
<div style="display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; color: #eef2f5;">
    <?= $this->title ?>&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;
</div>

<table role="presentation" class="bg-page" border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #eef2f5;" bgcolor="#eef2f5">
    <tr>
        <td align="center" style="padding: 32px 12px;">

            <!--[if mso]>
            <table role="presentation" align="center" border="0" cellspacing="0" cellpadding="0" width="600">
                <tr>
                    <td><![endif]-->
            <table role="presentation" class="container" border="0" cellpadding="0" cellspacing="0" width="600" style="width: 600px; max-width: 600px; margin: 0 auto;">

                <!-- ================= HEADER ================= -->
                <tr>
                    <td class="px bg-card" style="background-color: #ffffff; border-radius: 16px 16px 0 0; padding: 24px 32px 20px 32px;" bgcolor="#ffffff">
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                                <!-- Logo -->
                                <td class="stack" valign="middle" style="width: 50%;">
                                    <a href="https://www.sac-pilatus.ch" style="text-decoration: none;">
                                        <span class="logo-wrap" style="display: inline-block;">
                                        <img src="https://www.sac-pilatus.ch/files/theme-sac-pilatus/images/logos/logo-header.png" width="120" height="50" alt="SAC Sektion Pilatus" style="display: block; width: 120px; height: auto; border: 0;">
                                        </span>
                                    </a>
                                </td>
                                <!-- Navigation -->
                                <td class="stack nav-cell" valign="middle" align="right" style="width: 50%; font-family: Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px;">
                                    <a class="nav-pill" href="https://www.sac-pilatus.ch/touren-trainings-und-anlaesse.html" style="display: inline-block; color: #0f1f2e; font-weight: 700; text-decoration: none; padding: 6px 12px; border-radius: 999px; background-color: #f2f5f8;">Touren</a>
                                    <a class="nav-pill" href="https://www.sac-pilatus.ch/kurse.html" style="display: inline-block; color: #0f1f2e; font-weight: 700; text-decoration: none; padding: 6px 12px; border-radius: 999px; background-color: #f2f5f8; margin-left: 6px;">Kurse</a>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- ================= HERO ================= -->
                <tr>
                    <td class="bg-card" style="background-color: #ffffff; padding: 0 0 0 0;" bgcolor="#ffffff">
                        <a href="https://www.sac-pilatus.ch" style="text-decoration: none;">
                            <img src="https://www.sac-pilatus.ch/files/fileadmin/page_assets/newsletter/newsletter-800x340.jpg" width="600" alt="SAC Sektion Pilatus – Newsletter" style="display: block; width: 100%; max-width: 600px; height: auto; border: 0;">
                        </a>
                    </td>
                </tr>

                <!-- Farbakzent unter dem Bild -->
                <tr>
                    <td class="bg-card" style="background-color: #ffffff;" bgcolor="#ffffff">
                        <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
                            <tr>
                                <td style="height: 5px; font-size: 5px; line-height: 5px; background-color: #be0b15;" bgcolor="#be0b15">&nbsp;</td>
                                <td style="height: 5px; font-size: 5px; line-height: 5px; background-color: #026ca0;" bgcolor="#026ca0">&nbsp;</td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <!-- ================= KICKER ================= -->
                <tr>
                    <td class="px bg-card kicker" style="background-color: #ffffff; padding: 32px 32px 0 32px; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 16px; letter-spacing: 1.5px; text-transform: uppercase; font-weight: 700; color: #be0b15;" bgcolor="#ffffff">
                        {{ kickerText }}
                    </td>
                </tr>

                <!-- ================= INHALT ================= -->
                <tr>
                    <td class="px content bg-card" style="background-color: #ffffff; padding: 12px 32px 16px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 26px; color: #3a4654;" bgcolor="#ffffff">
                        <!-- Ab hier: Inhalt des Newsletters (h1, h2, p, hr, ul, b …) -->
                        {{ body|raw }}
                        <!-- Ende Inhalt -->
                    </td>
                </tr>

                <!-- ================= FOOTER ================= -->
                <tr>
                    <td class="px bg-footer" align="center" style="background-color: #0f1f2e; border-radius: 0 0 16px 16px; padding: 28px 32px; font-family: Helvetica, Arial, sans-serif; font-size: 13px; line-height: 20px; color: #9fb0c0;" bgcolor="#0f1f2e">
                        <p class="ft-title" style="margin: 0 0 4px 0; font-size: 14px; font-weight: 700; color: #ffffff;">SAC Sektion Pilatus</p>
                        <p class="ft-text" style="margin: 0 0 12px 0;">{{ addressFooter|raw }}</p>
                        <p style="margin: 0;">
                            <a class="ft-link-primary" href="https://www.sac-pilatus.ch/" rel="noopener" target="_blank" style="color: #ffffff; text-decoration: underline;">www.sac-pilatus.ch</a>
                        </p>
                    </td>
                </tr>

                {% if unsubscribeUrl|default %}
                    <!-- ================= ABMELDEN ================= -->
                    <tr>
                        <td class="px unsub" align="center" style="padding: 20px 32px 0 32px; font-family: Helvetica, Arial, sans-serif; font-size: 12px; line-height: 18px; color: #7b8794;">
                            <a class="unsub-link" href="{{ unsubscribeUrl|raw }}" style="color: #7b8794; text-decoration: underline;">Newsletter abbestellen</a>
                        </td>
                    </tr>
                {% endif %}

            </table>
            <!--[if mso]></td></tr></table><![endif]-->

        </td>
    </tr>
</table>
