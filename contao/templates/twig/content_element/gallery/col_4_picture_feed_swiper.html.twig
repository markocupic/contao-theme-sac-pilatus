{# Customization: Marko Cupic, 04.2025 #}
{# Show each figure of a contao gallery in a Bootstrap Card & and a swiper.js slider #}

{% extends "@Contao/content_element/_base.html.twig" %}
{% use "@Contao/component/_list.html.twig" %}
{% use "@Contao/component/_figure.html.twig" %}

{% set attributes = attrs(attributes|default).addClass('swiper swiper_picture_feed_slider_'~ data.id) %}
{#
{% set attributes = attrs(attributes|default).addClass("content-#{type}--cols-#{items_per_row|default(4)}") %}
#}

{% block content %}
    {% with {items: images} %}{{ block('list_component') }}{% endwith %}
    {% add to head %}
        {# include swiper.js #}
        <link rel="stylesheet" href="{{ asset('swiper/swiper-bundle.css', 'markocupic_contao_theme_sac_pilatus') }}">
        <script src="{{ asset('swiper/swiper-bundle.js', 'markocupic_contao_theme_sac_pilatus') }}"></script>
        {# Include swiper options #}
        {% include '@Contao_MarkocupicContaoThemeSacPilatus/swiper/swiper_options.html.twig' %}
    {% endadd %}
{% endblock %}

{% block list %}
    {# Add bootstrap row classes #}
    {% set list = list|merge({'list_attributes': attrs(list.list_attributes|default)
        .addClass('swiper-wrapper py-3 m-0')
    }) %}

    {% set list = list|merge({'item_attributes': attrs(list.item_attributes|default)
        .addClass('__grid-card-item swiper-slide h-100')
    }) %}

    {{ parent() }}
    <div class="swiper-pagination"></div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <script>
        (() => {
            const customSwiperOptions = {};
            const options = {...swiperOptions, ...customSwiperOptions};
            const swiper = new Swiper('.swiper_picture_feed_slider_{{ data.id }}', options);
        })();
    </script>
{% endblock %}

{% block list_item %}
    {% set owner = mpf_getOwnerFromUuid(item.metadata.uuid|default) %}
    {% set file = mpf_getFilesModelFromUuid(item.metadata.uuid) %}
    <div class="card bg-white shadow-sm">
        <div class="image-zoom-in" style="overflow:hidden">
            {% block figure_component %}
                {% set figure = item %}
                {% block caption %}{# Do not output the figcaption #}{% endblock %}
                {{ parent() }}
            {% endblock %}
        </div>
        <div class="card-body bg-white p-3">
            <p class="card-news-teaser mb-0">{{ item.metadata.caption }}</p>
        </div>
        <div class="card-footer border-top-0 bg-white p-3">
            <div class="d-flex align-items-center">
                {{ insert_tag('image::'~getAvatarResourcePath(owner)~'?width=40&height=40&mode=crop&class=rounded-circle')|raw }}
                <div class="d-flex flex-column ps-3">
                    <p class="card-text m-0 fw-bold"><small>{{ owner.firstname }} {{ owner.lastname }}</small></p>
                    <p class="card-date text-muted m-0">
                        <small>
                            <time datetime="{{ file.tstamp|date('Y-m-d\TH:i:sP') }}">
                                {{ file.tstamp|date("d.m.Y") }}
                            </time>
                        </small>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block media_link %}
    {# Add caption for glightbox usage #}
    {% if figure.metadata.caption|default %}
        {% set photographer = figure.metadata.get('photographer')|default('') %}
        {% set caption = figure.metadata.get('caption')|default('') %}
        {% set caption_text = 'title:' ~ (photographer ? photographer ~ ' - ' ~ caption : caption) %}
        {% set link_attributes = attrs(figure.linkAttributes(true)|default).set('data-glightbox', caption_text) %}
    {% endif %}
    {{ parent() }}
{% endblock %}
